{
  "name": "get-it-done",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --recursive run dev",
    "dev:api": "pnpm --filter @get-it-done/api run dev",
    "dev:web": "pnpm --filter @get-it-done/web run dev",
    "build": "pnpm --recursive run build",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "pnpm --filter @get-it-done/api exec prisma migrate dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm --recursive run typecheck",
    "prepare": "git config core.hooksPath .githooks",
    "test": "pnpm --recursive run test",
    "test:integration": "pnpm --filter @get-it-done/api run test:integration"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "git-validator-cli": "0.26.2"
  }
}
